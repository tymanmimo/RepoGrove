{
  "name": "github-analyzer",
  "version": "0.1.0",
  "description": "A CLI tool for analyzing public GitHub profiles",
  "type": "module",
  "bin": {
    "github-analyzer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "start": "node dist/cli.js",
    "test": "tsx --test tests/analyzer.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "octokit": "^5.0.5",
    "ora": "^9.4.1"
  }
}
