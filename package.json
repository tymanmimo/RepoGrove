{
  "name": "repogrove",
  "version": "0.1.0",
  "description": "Explore public GitHub profiles in your terminal",
  "type": "module",
  "bin": {
    "repogrove": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "start": "node dist/cli.js",
    "test": "tsx --test tests/core/profile-analyzer.test.ts tests/github/errors.test.ts tests/storage/history-store.test.ts tests/ui/app.test.tsx tests/ui/token-setup.test.tsx tests/ui/workspace.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "octokit": "^5.0.5",
    "react": "^19.2.8"
  }
}
